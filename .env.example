# Copy to backend/.env and fill in. Never commit real keys. Never expose them to the frontend.

# --- Language-model layer (optional: IGNIS works with no LLM at all) ---
# AUTO = Gemini first, visible fallback to Ollama, then no-LLM | CLOUD | LOCAL | NONE
IGNIS_LLM_MODE=AUTO

# Google Gemini (cloud). Use a model that is actually enabled on your account.
GEMINI_API_KEY=
IGNIS_GEMINI_MODEL=

# Ollama (local only; not available in the cloud deployment)
IGNIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
IGNIS_OLLAMA_MODEL=qwen3:8b

IGNIS_LLM_TIMEOUT_S=60

# --- CORS (comma-separated JSON list of allowed frontend origins) ---
IGNIS_ALLOWED_ORIGINS=["http://localhost:5173"]
