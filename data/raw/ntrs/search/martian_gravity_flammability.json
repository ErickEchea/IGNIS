:"53173ac1b04d4579a5d02298f431b6f3","belongsToAuthors":false},"subjectCategories":["Inorganic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":19930040901,"ear":"NO","id":"96aeb7fa974645de80a480bc0ad1b198","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["AIAA PAPER 93-0828","E-8377","Report Number: AIAA PAPER 93-0828","Report Number: E-8377"],"fundingNumbers":[{"number":"NAG3-1046","submissionId":19930040901,"id":"1e370da27af24bbb9865ed63d33ad843","type":"CONTRACT_GRANT"}],"title":"Downward Diffusion Flame Spread and Extinction in Variable Gravitational Fields - Lunar and Martian Simulations","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-16T00:57:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19930040901,"meta":{"author":{"name":"Sacksteder, Kurt R."},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"107989a378ee41efafb7f0d02437e081"},{"sequence":1,"submissionId":19930040901,"meta":{"author":{"name":"Tien, James S."},"organization":{"name":"Case Western Reserve Univ.","location":"Cleveland, OH, United States"}},"id":"3f2808278c064ad7a144bab39cbd780c"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19930040901,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"93A24898"},"created":"2013-08-16T00:57:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"This paper describes experimental observations of downward, opposed-flow flame spreading made under partial-gravity conditions aboard NASA research aircraft. Flame spreading and flammability limit behavior of a thin cellulosic fuel tested at normal pressure in oxygen/nitrogen mixtures of 21 percent oxygen, by volume, and below are described over effective acceleration levels ranging from 0.05 to 0.6 times normal earth gravity. Downward burning flammability and flame spread rates are shown to be enhanced by reductions in gravitational acceleration. These data have fire safety implications for the planning of lunar and Martian outposts.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","meetings":[{"submissionId":19930040901,"name":"AIAA","id":"3f6ffbbd3e964096bdec760e2829f855"},{"country":"United States","submissionId":19930040901,"endDate":"1993-01-14T00:00:00.0000000+00:00","sponsors":[{"meta":{"organization":{"name":"AIAA"}},"meetingId":"94d3c712e25b41698dacde73a0807b2c","id":"871d638286014516b591cb48f0a13d0e"}],"name":"AIAA, Aerospace Sciences Meeting and Exhibit","location":"Reno, NV","id":"94d3c712e25b41698dacde73a0807b2c","startDate":"1993-01-11T00:00:00.0000000+00:00"}],"publications":[{"submissionId":19930040901,"id":"4902565b2c9e4c41b526992dce65fcd6","publicationDate":"1993-01-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":120.26382},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20010074096,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"d7306b91914d488fb39df8021a14c63b","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20010074096,"ear":"NO","id":"35cdc6863a554a998e39ce09958e263c","itar":"NO"},"distributionDate":"2016-06-06T00:00:00.0000000+00:00","title":"An Earth-Based Equivalent Low Stretch Apparatus to Assess Material Flammability for Microgravity & Extraterrestrial Fire-Safety Applications","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-20T11:27:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20010074096,"meta":{"author":{"name":"Olson, S. L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH United States"}},"id":"f36e8df9eb844440abee8efa962f545b"},{"sequence":1,"submissionId":20010074096,"meta":{"author":{"name":"Beeson, H."},"organization":{"name":"NASA White Sands Test Facility","location":"NM United States"}},"id":"7f890bf5aac043488e077cbc48975eda"},{"sequence":2,"submissionId":20010074096,"meta":{"author":{"name":"Haas, J."},"organization":{"name":"NASA White Sands Test Facility","location":"NM United States"}},"id":"5e374378ecd7453bbab790cae0adbf56"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20010074096,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-20T11:27:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"One of the performance goals for NASA's enterprise of Human Exploration and Development of Space (HEDS) is to develop methods, data bases, and validating tests for material flammability characterization, hazard reduction, and fire detection/suppression strategies for spacecraft and extraterrestrial habitats. This work addresses these needs by applying the fundamental knowledge gained from low stretch experiments to the development of a normal gravity low stretch material flammability test method. The concept of the apparatus being developed uses the low stretch geometry to simulate the conditions of the extraterrestrial environment through proper scaling of the sample dimensions to reduce the buoyant stretch in normal gravity. The apparatus uses controlled forced-air flow to augment the low stretch to levels which simulate Lunar or Martian gravity levels. In addition, the effect of imposed radiant heat flux on material flammability can be studied with the cone heater. After breadboard testing, the apparatus will be integrated into NASA's White Sands Test Facility's Atmosphere-Controlled Cone Calorimeter for evaluation as a new materials screening test method.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20010074096,"id":"d8bb4637b436490e83acc463c44b89ee","publicationName":"Sixth International Microgravity Combustion Workshop","publicationDate":"2001-05-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20010074096.pdf","type":"STI","links":{"original":"/api/citations/20010074096/downloads/20010074096.pdf","pdf":"/api/citations/20010074096/downloads/20010074096.pdf","fulltext":"/api/citations/20010074096/downloads/20010074096.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":91.36624},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20010074003,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"8a0443e23b8c4462afcb76032856cfa6","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20010074003,"ear":"NO","id":"6cd281297a74440cbc8659fb065b4621","itar":"NO"},"distributionDate":"2016-06-06T00:00:00.0000000+00:00","title":"Three-Dimensional Upward Flame Spreading in Partial-Gravity Buoyant Flows","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-20T11:23:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20010074003,"meta":{"author":{"name":"Sacksteder, Kurt R."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH United States"}},"id":"55e4e92fe65949c88d3fdc079ae97023"},{"sequence":1,"submissionId":20010074003,"meta":{"author":{"name":"Feier, Ioan I."},"organization":{"name":"Case Western Reserve Univ.","location":"Cleveland, OH United States"}},"id":"7478c8a22f2c448fb60ec93257d3e74f"},{"sequence":2,"submissionId":20010074003,"meta":{"author":{"name":"Shih, Hsin-Yi"},"organization":{"name":"Case Western Reserve Univ.","location":"Cleveland, OH United States"}},"id":"ede2e581fba54628b626919f6c4d75f2"},{"sequence":3,"submissionId":20010074003,"meta":{"author":{"name":"T'ien, James S."},"organization":{"name":"Case Western Reserve Univ.","location":"Cleveland, OH United States"}},"id":"d8073c46b3324a729059d382972ffb6f"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20010074003,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-20T11:23:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Reduced-gravity environments have been used to establish low-speed, purely forced flows for both opposed- and concurrent-flow flame spread studies. Altenkirch's group obtained spacebased experimental results and developed unsteady, two-dimensional numerical simulations of opposed-flow flame spread including gas-phase radiation, primarily away from the flammability limit for thin fuels, but including observations of thick fuel quenching in quiescent environments. T'ien's group contributed some early flame spreading results for thin fuels both in opposed flow and concurrent flow regimes, with more focus on near-limit conditions. T'ien's group also developed two- and three-dimensional numerical simulations of concurrent-flow flame spread incorporating gas-phase radiative models, including predictions of a radiatively-induced quenching limit reached in very low-speed air flows. Radiative quenching has been subsequently observed in other studies of combustion in very low-speed flows including other flame spread investigations, droplet combustion and homogeneous diffusion flames, and is the subject of several contemporary studies reported in this workshop. Using NASA aircraft flying partial-gravity \"parabolic\" trajectories, flame spreading in purely buoyant, opposed-flow (downward burning) has been studied. These results indicated increases in flame spread rates and enhanced flammability (lower limiting atmospheric oxygen content) as gravity levels were reduced from normal Earth gravity, and were consistent with earlier data obtained by Altenkirch using a centrifuge. In this work, experimental results and a three-dimensional numerical simulation of upward flame spreading in variable partial-gravity environments were obtained including some effects of reduced pressure and variable sample width. The simulation provides physical insight for interpreting the experimental results and shows the intrinsic 3-D nature of buoyant, upward flame spreading. This study is intended to link the evolving understanding of flame spreading in purely-forced flows to the purely-buoyant flow environment, particularly in the concurrent flow regime; provide additional insight into the existence of steady flame spread in concurrent flows; and stimulate direct comparisons between opposed- and concurrent-flow flame spread. Additionally, this effort is intended to provide direct practical understanding applicable to fire protection planning for the habitable facilities in partial gravity environments of anticipated Lunar and Martian explorations.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20010074003,"id":"a4ec27a6474e454c996f9459681b53ea","publicationName":"Sixth International Microgravity Combustion Workshop","publicationDate":"2001-05-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20010074003.pdf","type":"STI","links":{"original":"/api/citations/20010074003/downloads/20010074003.pdf","pdf":"/api/citations/20010074003/downloads/20010074003.pdf","fulltext":"/api/citations/20010074003/downloads/20010074003.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":71.43662},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20040161244,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"29974059ad6f4c6596ea9c3fb716b593","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20040161244,"ear":"NO","id":"87833ed5c79f407785a2be44c247d696","itar":"NO"},"distributionDate":"2018-06-05T00:00:00.0000000+00:00","title":"Most Probable Fire Scenarios in Spacecraft and Extraterrestrial Habitats: Why NASA's Current Test 1 Might Not Always be Conservative","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-09-07T11:50:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20040161244,"meta":{"author":{"name":"Olson, S. L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"e890ccb0a36849c190b17e4eba0655da"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20040161244,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-09-07T11:50:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"NASA's current method of material screening determines fire resistance under conditions representing a worst-case for normal gravity flammability - the Upward Flame Propagation Test (Test 1). Its simple pass-fail criteria eliminates materials that burn for more than 12 inches from a standardized ignition source. In addition, if a material drips burning pieces that ignite a flammable fabric below, it fails. The applicability of Test 1 to fires in microgravity and extraterrestrial environments, however, is uncertain because the relationship between this buoyancy-dominated test and actual extraterrestrial fire hazards is not understood. There is compelling evidence that the Test 1 may not be the worst case for spacecraft fires, and we don t have enough information to assess if it is adequate at Lunar or Martian gravity levels.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20040161244,"id":"39acd6082e154ca9afec41ad6e271b89","publicationName":"Strategic Research to Enable NASA's Exploration Missions Conference and Workshop: Poster Session, Volume 2","publicationDate":"2004-08-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20040161185,"type":"ANALYTIC_PRIMARY","title":"Strategic Research to Enable NASA's Exploration Missions Conference and Workshop: Poster Session","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20040161185,"type":"ANALYTIC_PRIMARY","title":"Strategic Research to Enable NASA's Exploration Missions Conference and Workshop: Poster Session","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20040161244.pdf","type":"STI","links":{"original":"/api/citations/20040161244/downloads/20040161244.pdf","pdf":"/api/citations/20040161244/downloads/20040161244.pdf","fulltext":"/api/citations/20040161244/downloads/20040161244.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":71.38417},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20040084156,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"0820c607c2d14ecbbd63d0c7c7c2e67c","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20040084156,"ear":"NO","id":"a839d96eaad744d19854e8c2c50ae275","itar":"NO"},"distributionDate":"2018-06-05T00:00:00.0000000+00:00","title":"Most Probable Fire Scenarios in Spacecraft and Extraterrestrial Habitats: Why NASA's Current Test 1 Might Not Always Be Conservative","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-21T22:44:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20040084156,"meta":{"author":{"name":"Olson, S. L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"2e3f2b85632f4a5c8a2f67430a28147a"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20040084156,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-21T22:44:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"NASA s current method of material screening determines fire resistance under conditions representing a worst-case for normal gravity flammability - the Upward Flame Propagation Test (Test 1[1]). Its simple pass-fail criteria eliminates materials that burn for more than 12 inches from a standardized ignition source. In addition, if a material drips burning pieces that ignite a flammable fabric below, it fails. The applicability of Test 1 to fires in microgravity and extraterrestrial environments, however, is uncertain because the relationship between this buoyancy-dominated test and actual extraterrestrial fire hazards is not understood. There is compelling evidence that the Test 1 may not be the worst case for spacecraft fires, and we don t have enough information to assess if it is adequate at Lunar or Martian gravity levels.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20040084156,"id":"c4ab1aa9389d4951948144acbf08f2de","publicationName":"Strategic Research to Enable NASA's Exploration Missions Conference","publicationDate":"2004-06-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20040084137,"type":"ANALYTIC_PRIMARY","title":"Strategic Research to Enable NASA's Exploration Missions Conference","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20040084137,"type":"ANALYTIC_PRIMARY","title":"Strategic Research to Enable NASA's Exploration Missions Conference","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20040084156.pdf","type":"STI","links":{"original":"/api/citations/20040084156/downloads/20040084156.pdf","pdf":"/api/citations/20040084156/downloads/20040084156.pdf","fulltext":"/api/citations/20040084156/downloads/20040084156.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":61.92241},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20010074098,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"6caeff80098f4138b5d46721b82ac8be","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20010074098,"ear":"NO","id":"6c90cb418fa64b44bbd757d46334e2b5","itar":"NO"},"distributionDate":"2019-08-15T08:39:34.3870000+00:00","title":"Physical and Chemical Aspects of Fire Suppression in Extraterrestrial Environments","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-20T11:27:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20010074098,"meta":{"author":{"name":"Takahashi, F."},"organization":{"name":"National Center for Microgravity Research on Fluids and Combustion","location":"Cleveland, OH United States"}},"id":"ad1a9bf621cd4c4b8d007db09c87d647"},{"sequence":1,"submissionId":20010074098,"meta":{"author":{"name":"Linteris, G. T."},"organization":{"name":"National Inst. of Standards and Technology","location":"Gaithersburg, MD United States"}},"id":"72379faf96f24bc1a90d4a910c6ba3ba"},{"sequence":2,"submissionId":20010074098,"meta":{"author":{"name":"Katta, V. R."},"organization":{"name":"Innovative Scientific Solutions, Inc.","location":"Dayton, OH United States"}},"id":"6b7e7d70b6354af888fb96797c5e6ae8"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20010074098,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-20T11:27:00.0000000+00:00","center":{"code":"HQ","name":"Headquarters","id":"f0865a34ba1f474d865ab51f212fc69f"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"A fire, whether in a spacecraft or in occupied spaces on extraterrestrial bases, can lead to mission termination or loss of life. While the fire-safety record of US space missions has been excellent, the advent of longer duration missions to Mars, the moon, or aboard the International Space Station (ISS) increases the likelihood of fire events, with more limited mission termination options. The fire safety program of NASA's manned space flight program is based largely upon the principles of controlling the flammability of on-board materials and greatly eliminating sources of ignition. As a result, very little research has been conducted on fire suppression in the microgravity or reduced-gravity environment. The objectives of this study are: to obtain fundamental knowledge of physical and chemical processes of fire suppression, using gravity and oxygen concentration as independent variables to simulate various extraterrestrial environments, including spacecraft and surface bases in Mars and moon missions; to provide rigorous testing of analytical models, which include comprehensive descriptions of combustion and suppression chemistry; and to provide basic research results useful for technological advances in fire safety, including the development of new fire-extinguishing agents and approaches, in the microgravity environment associated with ISS and in the partial-gravity Martian and lunar environments.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20010074098,"id":"9fd819e3063c43c7ba9b7cac6c683385","publicationName":"Sixth International Microgravity Combustion Workshop","publicationDate":"2001-05-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20010074098.pdf","type":"STI","links":{"original":"/api/citations/20010074098/downloads/20010074098.pdf","pdf":"/api/citations/20010074098/downloads/20010074098.pdf","fulltext":"/api/citations/20010074098/downloads/20010074098.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":61.552086},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20010074017,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"2f0cc31589014ba2a28ddbf2dcf875eb","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20010074017,"ear":"NO","id":"c941154fa2eb40f6a7b91144357739cd","itar":"NO"},"distributionDate":"2016-06-06T00:00:00.0000000+00:00","title":"Low Stretch PMMA Burning in Microgravity: Status of the Ground-Based Program and New ISS Glovebox Experiment SALSA","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-20T11:23:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20010074017,"meta":{"author":{"name":"Olson, S. L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH United States"}},"id":"b52186e798064fb887f6400589044ee0"},{"sequence":1,"submissionId":20010074017,"meta":{"author":{"name":"T'ien, J. S."},"organization":{"name":"Case Western Reserve Univ.","location":"Cleveland, OH United States"}},"id":"239c511764a54a8288c703b01a89e2fa"},{"sequence":2,"submissionId":20010074017,"meta":{"author":{"name":"Armstrong, J. B."},"organization":{"name":"Case Western Reserve Univ.","location":"Cleveland, OH United States"}},"id":"2c74a9a99642434db399ae66a1e67ab7"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20010074017,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-20T11:23:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The objective of this ground-based program is to study low stretch diffusion flames burning PMMA as the solid fuel to determine the relationship between buoyant low stretch burning in normal gravity and forced flow low stretch burning in microgravity. The low stretch is generated in normal gravity by using the buoyant convection induced by burning the bottom of a large radius of curvature sample. Low stretch is also generated using the Combustion Tunnel drop tower rig (2.2 and 5.2 second facilities), which provides a forced convective low velocity flow past smaller radius of curvature samples. Lastly, an ISS glovebox investigation is being developed to study low stretch burning of PMMA spheres to obtain long duration testing needed to accurately assess the flammability and burning characteristics of the material in microgravity. A comparison of microgravity experiment results with normal gravity test results allows us to establish a direct link between a material's burning characteristics in normal gravity (easily measured) with its burning characteristics in extraterrestrial environments, including microgravity forced convective environments. Theoretical predictions and recent experimental results indicate that it should be possible to understand a material's burning characteristics in the low stretch environment of spacecraft (non-buoyant air movement induced by fans and crew disturbances) by understanding its burning characteristics in an equivalent Earth-based low stretch environment (induced by normal gravity buoyancy). Similarly, Earth-based stretch environments can be made equivalent to those in Lunar- and Martian-surface stretch environments (which would induce partial-gravity buoyancy).","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20010074017,"id":"80c23dbbec684968b3504b11159a3251","publicationName":"Sixth International Microgravity Combustion Workshop","publicationDate":"2001-05-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20010074017.pdf","type":"STI","links":{"original":"/api/citations/20010074017/downloads/20010074017.pdf","pdf":"/api/citations/20010074017/downloads/20010074017.pdf","fulltext":"/api/citations/20010074017/downloads/20010074017.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}],"aggregations":{"created":{"buckets":[{"key_as_string":"2013","key":1356998400000,"doc_count":8},{"key_as_string":"2026","key":1767225600000,"doc_count":2}]},"author":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"Olson, S. L.","doc_count":4},{"key":"Nathan Kralik","doc_count":2},{"key":"Paul Ferkul","doc_count":2},{"key":"Sacksteder, Kurt R.","doc_count":2},{"key":"Ya-Ting Liao","doc_count":2},{"key":"Armstrong, J. B.","doc_count":1},{"key":"Beeson, H.","doc_count":1},{"key":"Feier, Ioan I.","doc_count":1},{"key":"Ferkul, Paul","doc_count":1},{"key":"Haas, J.","doc_count":1},{"key":"Katta, V. R.","doc_count":1},{"key":"Linteris, G. T.","doc_count":1},{"key":"Michael Johnston","doc_count":1},{"key":"Oslon, Sandra. L.","doc_count":1},{"key":"Shih, Hsin-Yi","doc_count":1},{"key":"T'ien, J. S.","doc_count":1},{"key":"T'ien, James S.","doc_count":1},{"key":"Takahashi, F.","doc_count":1},{"key":"Tien, James S.","doc_count":1}]},"reportNumber":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"AIAA PAPER 93-0828","doc_count":1},{"key":"E-8377","doc_count":1},{"key":"Report Number: AIAA PAPER 93-0828","doc_count":1},{"key":"Report Number: E-8377","doc_count":1}]},"center":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"GRC","doc_count":8},{"key":"CDMS","doc_count":1},{"key":"HQ","doc_cou